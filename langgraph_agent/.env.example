# LangGraph agent environment variables
# Copy to `.env` and fill in real values.

# ---------------------------------------------------------------------------
# Model  (required)
# ---------------------------------------------------------------------------
# Google Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key

# Overrides the provider's default model. Leave unset to take the default:
#   gemini-2.5-pro
# Set this when Gemini retires or renames a model.
LLM_MODEL=

TEMPERATURE=0
LLM_MAX_RETRIES=2
# Output cap per Gemini call.
LLM_MAX_OUTPUT_TOKENS=4096

# ---------------------------------------------------------------------------
# Dataset service
# ---------------------------------------------------------------------------
SQLITE_SERVICE_URL=http://localhost:3001
# Must match SERVICE_TOKEN in sqlite_server/.env and server/.env.
SERVICE_TOKEN=change-me-shared-between-services
SQLITE_REQUEST_TIMEOUT=60

# ---------------------------------------------------------------------------
# Chart generation
# ---------------------------------------------------------------------------
# Charts render inside a local Docker container with no network access.
CHART_DOCKER_ENABLED=true
CHART_EXECUTOR_IMAGE=querybot-chart-executor
CHART_OUTPUT_DIR=./generated_charts
CHART_TIMEOUT=120

# ---------------------------------------------------------------------------
# Query limits
# ---------------------------------------------------------------------------
MAX_RESULT_ROWS=5000
# Rows sent to the model for analysis; the full result still reaches the client.
LLM_SAMPLE_ROWS=30

# ---------------------------------------------------------------------------
# Conversation
# ---------------------------------------------------------------------------
# Recognise a follow-up that only changes presentation ("make it a pie chart",
# "use warmer colours", "top 5 only") and re-run the previous query rather than
# writing a new one. Set to false to answer every turn from scratch.
REFINE_FOLLOWUPS=true
# Follow-up question suggestions offered after each answer.
SUGGEST_FOLLOWUPS=true

# ---------------------------------------------------------------------------
# Tracing  (optional)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=querybot-agent
